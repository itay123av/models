HOST=127.0.0.1
PORT=8790
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.6-luna
OPENAI_LABEL_MODEL=gpt-5.6-luna
OPENAI_LABEL_ESCALATION_MODEL=gpt-5.6-terra
OPENAI_LABEL_ESCALATION_ENABLED=false
OPENAI_LABEL_ESCALATION_CONFIDENCE=0.78
OPENAI_LABEL_TARGETED_RETRY_ENABLED=true
OPENAI_LABEL_TARGETED_RETRY_MAX_BATCHES=2
OPENAI_TOPOLOGY_MODEL=gpt-5.6-luna
OPENAI_TOPOLOGY_AUDIT_MODEL=gpt-5.6-luna
OPENAI_TOPOLOGY_ESCALATION_MODEL=gpt-5.6-terra
OPENAI_TOPOLOGY_ESCALATION_ENABLED=false
OPENAI_TOPOLOGY_ESCALATION_CONFIDENCE=0.78
OPENAI_TOPOLOGY_LINE_GEOMETRY_ENABLED=true
OPENAI_REASONING_EFFORT=medium
OPENAI_ESCALATION_REASONING_EFFORT=high
OPENAI_TIMEOUT_MS=240000
RATE_LIMIT_WINDOW_MS=60000
MAX_PARSE_REQUESTS=12
MAX_CONCURRENT_PARSES=2
OPENAI_SCAN_MAX_ESTIMATED_USD=0.10
OPENAI_SCAN_MAX_API_CALLS=16
OPENAI_SCAN_BUDGET_TTL_MS=3600000

